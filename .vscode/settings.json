{
  "css.validate": false,
  "less.validate": false,
  "scss.validate": false,
  "tailwindCSS.includeLanguages": {
    "html": "html",
    "javascript": "javascript",
    "css": "css",
    "svelte": "html"
  },
  "tailwindCSS.experimental.classRegex": [
    ["class:([^=]+)=", "\"([^\"]*)\""],
    ["class=\"([^\"]*)\""],
    ["class=`([^`]*)`"],
    ["class='([^']*)'"]
  ]
}